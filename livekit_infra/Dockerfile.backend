# ─────────────────────────────────────────────────────────────────
# TalkHire Backend — Production Dockerfile
# ─────────────────────────────────────────────────────────────────
#
# Slim Python 3.12 container serving the FastAPI interview agent
# backend and pre-built React frontend static assets.
#
# Build:  docker build -f livekit/Dockerfile.backend -t talkhire .
# Run:    docker run -p 7862:7862 --env-file .env talkhire
# ─────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev --frozen 2>/dev/null || uv sync --no-dev

COPY bot/ ./bot/
COPY frontend/dist/ ./frontend/dist/

EXPOSE 7862

HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -f http://localhost:7862/health || exit 1

CMD ["uv", "run", "python", "-m", "bot.bot"]
