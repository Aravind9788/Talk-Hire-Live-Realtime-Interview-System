# ==============================================================================
# TalkHire Real-Time AI Interview Agent Environment Configuration Example
# ==============================================================================

# ── LiveKit WebRTC Voice Infrastructure
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_ROOM_PREFIX=talkhire
LIVEKIT_TOKEN_TTL_MINUTES=60

# ── Azure OpenAI Realtime & Text API Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-4o-mini

# ── Standard OpenAI API (Fallback)
OPENAI_API_KEY=your_standard_openai_api_key_here
OPENAI_VOICE=alloy

# ── Application Runtime & Session Storage
APP_NAME=TalkHire
PORT=7862
SESSION_PERSIST_DIR=.aura_sessions
USER_IDLE_TIMEOUT_SECS=300
MAX_CALL_DURATION_SECS=1200
